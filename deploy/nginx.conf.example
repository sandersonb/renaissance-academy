# Example nginx reverse proxy for the enrollment app.
#
# Security model (replaces the legacy "/admin open to any IP"):
#   - Parent portal + parent API: PUBLIC.
#   - Admin UI (/admin) + admin API (/api/admin): IP-restricted here at the edge,
#     PLUS an app-level allowlist (ADMIN_IP_ALLOWLIST) as defense-in-depth.
#
# If nginx itself sits behind another proxy/CDN, uncomment set_real_ip_from /
# real_ip_header so allow/deny and the app see the TRUE client IP (not the proxy).

upstream web { server 127.0.0.1:5173; }   # React (or a static file server in prod)
upstream api { server 127.0.0.1:3001; }   # Node API

server {
  listen 80;
  server_name enrollment.example.org;

  # --- real client IP when behind an upstream proxy/CDN ---
  # set_real_ip_from 192.0.2.26/32;  # replace with explicitly reviewed upstream host
  # real_ip_header   X-Forwarded-For;
  # real_ip_recursive on;

  # Pass the real client IP to the API so request.ip / app allowlist work
  # (the API must run with TRUST_PROXY=true).
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  add_header Referrer-Policy "no-referrer" always;
  add_header Cache-Control "no-store" always;
  add_header X-Content-Type-Options nosniff always;

  # --- ADMIN: IP-restricted ---
  location /admin/ {                  # admin UI
    allow 203.0.113.0/24;             # office network
    allow 198.51.100.7;               # a specific admin
    deny all;
    proxy_pass http://web;
  }
  location /api/admin/ {              # admin API
    allow 203.0.113.0/24;
    allow 198.51.100.7;
    deny all;
    proxy_pass http://api;
  }

  # --- PUBLIC: parent portal + parent API ---
  location /api/ { proxy_pass http://api; }
  location /     { proxy_pass http://web; }
}
