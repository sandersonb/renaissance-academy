{
  "name": "renaissance-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renaissance Academy enrollment lottery — React/TypeScript rebuild. M1: domain core.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "vitest run --config vitest.functional.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/app/http/main.ts",
    "start": "tsx src/app/http/main.ts",
    "db:migrate": "tsx src/app/adapters/mysql/migrate.ts",
    "db:import-roster": "tsx src/app/cli/importRoster.ts",
    "db:seed": "tsx src/app/cli/seed.ts",
    "db:seed:pre": "tsx src/app/cli/seed.ts --mode=pre-lottery",
    "db:seed:post": "tsx src/app/cli/seed.ts --mode=post-lottery",
    "admin:create": "tsx src/app/cli/createAdmin.ts",
    "lottery:demo": "tsx src/domain/lottery/demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "unix-crypt-td-js": "^1.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
