# Enrollment API configuration. Copy to .env for local non-Docker runs.
# (Docker Compose sets these itself — see docker-compose.yml.)

# Database — unset DB_HOST to use the in-memory store (no DB needed).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=secret
DB_NAME=enrollment

# Server
PORT=3001
APP_BASE_URL=http://localhost:5173

# Auth / hashing
BCRYPT_COST=12
DUAL_WRITE_LEGACY_CRYPT=true

# Annual settings (replace legacy page.pm globals)
YEAR_BEGIN=2026
LOTTERY_OPEN=true
POST_LOTTERY=false

# Parent-editable child fields (legacy: none). e.g. firstName,lastName,gradeNextYear
CHILD_EDITABLE_FIELDS=

# Admin access (M3). nginx is the primary IP gate; this is defense-in-depth.
ADMIN_IP_ALLOWLIST=
TRUST_PROXY=false
# First-boot admin bootstrap (or use: npm run admin:create -- --username alice)
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=

# Email (M4). Outbox worker drains every N ms (0 disables the in-process worker).
EMAIL_WORKER_INTERVAL_MS=60000
EMAIL_PROVIDER=console        # console | smtp
EMAIL_FROM=enrollment@renacademy.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email throttle (defaults tuned for consumer Gmail ~500/day). Raise the daily
# cap for Google Workspace. Pacing avoids short-burst rate blocks.
EMAIL_BATCH_SIZE=20           # max sends per drain
EMAIL_SEND_SPACING_MS=1500    # delay between individual sends
EMAIL_DAILY_CAP=400           # hard ceiling per rolling 24h
REMINDER_INTERVAL_MS=86400000 # daily reminder re-enqueue (0 disables)

# Registration paperwork: fallback PDF served when a packet slot has no upload.
DEFAULT_PACKET_PATH=assets/default-packet.pdf
